DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https://mc.yandex.ru https://www.google-analytics.com; script-src 'self' https://www.googletagmanager.com https://mc.yandex.ru; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://mc.yandex.ru; style-src 'self' 'unsafe-inline'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteRule ^(?:scripts|docs|adtc-private)(?:/|$) - [F,L,NC]

  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ https://adtc.kz/$1 [R=301,L,NE]

  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^adtc\.kz$ [NC]
  RewriteRule ^ https://adtc.kz%{REQUEST_URI} [R=301,L,NE]
</IfModule>

<FilesMatch "^(adtc-config\.php|\.env|.*service-account.*\.json|.*\.log|.*\.ndjson)$">
  Require all denied
</FilesMatch>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(?:svg|webp|png|jpe?g)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  <Files "investor-projects.json">
    Header set Cache-Control "no-store, max-age=0"
    Header set X-Robots-Tag "noindex, nofollow"
  </Files>
  Header append Vary Accept-Encoding
</IfModule>
